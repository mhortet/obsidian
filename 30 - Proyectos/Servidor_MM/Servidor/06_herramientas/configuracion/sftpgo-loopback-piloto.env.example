# Configuración no secreta del piloto doméstico de srv-mm-01.
# Se instala como /etc/sftpgo/srv-mm-piloto.env (root:sftpgo 0640).

SFTPGO_COMMON__UPLOAD_MODE=1
SFTPGO_COMMON__SETSTAT_MODE=1
SFTPGO_COMMON__MAX_TOTAL_CONNECTIONS=20
SFTPGO_COMMON__MAX_PER_HOST_CONNECTIONS=10

SFTPGO_SFTPD__BINDINGS__0__PORT=0
SFTPGO_FTPD__BINDINGS__0__PORT=0
SFTPGO_WEBDAVD__BINDINGS__0__PORT=0

SFTPGO_DATA_PROVIDER__DRIVER=sqlite
SFTPGO_DATA_PROVIDER__NAME=/var/lib/sftpgo/sftpgo.db
SFTPGO_DATA_PROVIDER__USERS_BASE_DIR=/srv/compartido/repositorio/piloto-20261106/usuarios

SFTPGO_HTTPD__BINDINGS__0__ADDRESS=127.0.0.1
SFTPGO_HTTPD__BINDINGS__0__PORT=18080
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_ADMIN=false
SFTPGO_HTTPD__BINDINGS__0__ENABLE_WEB_CLIENT=true
SFTPGO_HTTPD__BINDINGS__0__ENABLE_REST_API=false
SFTPGO_HTTPD__BINDINGS__0__HIDE_LOGIN_URL=2
SFTPGO_HTTPD__BINDINGS__0__RENDER_OPENAPI=false
SFTPGO_HTTPD__BINDINGS__0__LANGUAGES=en
SFTPGO_HTTPD__BINDINGS__0__SECURITY__ENABLED=true
SFTPGO_HTTPD__BINDINGS__0__SECURITY__CONTENT_TYPE_NOSNIFF=true
SFTPGO_HTTPD__BINDINGS__0__SECURITY__REFERRER_POLICY=no-referrer
SFTPGO_HTTPD__BINDINGS__0__SECURITY__CACHE_CONTROL=no-store

SFTPGO_HTTPD__BINDINGS__1__ADDRESS=127.0.0.1
SFTPGO_HTTPD__BINDINGS__1__PORT=18081
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_ADMIN=true
SFTPGO_HTTPD__BINDINGS__1__ENABLE_WEB_CLIENT=false
SFTPGO_HTTPD__BINDINGS__1__ENABLE_REST_API=true
SFTPGO_HTTPD__BINDINGS__1__HIDE_LOGIN_URL=1
SFTPGO_HTTPD__BINDINGS__1__RENDER_OPENAPI=false
SFTPGO_HTTPD__BINDINGS__1__LANGUAGES=en
SFTPGO_HTTPD__BINDINGS__1__SECURITY__ENABLED=true
SFTPGO_HTTPD__BINDINGS__1__SECURITY__CONTENT_TYPE_NOSNIFF=true
SFTPGO_HTTPD__BINDINGS__1__SECURITY__REFERRER_POLICY=no-referrer
SFTPGO_HTTPD__BINDINGS__1__SECURITY__CACHE_CONTROL=no-store

SFTPGO_KMS__SECRETS__MASTER_KEY_PATH=/etc/sftpgo/secrets/master.key

SFTPGO_LOG_LEVEL=info
SFTPGO_LOG_FILE_PATH=

